{
  "name": "durak-psychology-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --webpack",
    "dev:lan": "node scripts/dev-lan.mjs",
    "build": "prisma generate && next build --webpack",
    "start": "node scripts/start-production.mjs",
    "jobs:scheduled": "node scripts/scheduled-jobs.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run && node --test tests/production-config.test.mjs",
    "test:e2e": "playwright test",
    "test:public": "playwright test --config playwright.public.config.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx scripts/seed.ts",
    "db:local": "tsx scripts/local-database.ts",
    "admin:create": "tsx scripts/provision-admin.ts",
    "jobs": "tsx scripts/worker.ts",
    "demo:session": "tsx scripts/demo-session.ts",
    "demo:rotate-passwords": "tsx scripts/rotate-demo-passwords.ts",
    "format": "prettier --write src scripts tests e2e *.ts *.mjs *.json"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.0.0",
    "@prisma/client": "^7.0.0",
    "@radix-ui/react-dialog": "^1.1.15",
    "better-auth": "^1.4.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.0.0",
    "lucide-react": "^0.577.0",
    "next": "^16.0.0",
    "nodemailer": "^10.6.1",
    "pg": "^8.16.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwind-merge": "^3.3.0",
    "zod": "^4.0.0"
  },
  "overrides": {
    "effect": "^3.22.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.56.0",
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.15.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "embedded-postgres": "17.12.0-beta.19",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.0.0",
    "prettier": "^3.10.1",
    "prisma": "^7.0.0",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^4.0.0"
  }
}
